rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ideas/{ideaId} {
      // Anyone can read and write projects/ideas
      allow read, write: if true;
    }
    match /users/{userId} {
      // Anyone can read and write user registration records for collaboration list
      allow read, write: if true;
    }
  }
}
